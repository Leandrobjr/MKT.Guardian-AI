# ==========================================================================
# MKT Guardian AUTO - Modelo de variaveis de ambiente
# --------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com suas chaves reais.
# Na instalação atual, o arquivo real oficial fica na raiz:
# ../.env (MKT_Guardian-AI/.env). Este arquivo é apenas referência.
# NUNCA faca commit do arquivo ".env" (ele contem segredos).
# ==========================================================================

# --- Google Gemini (geracao de copy e de imagem / Nano Banana) ---
# Obrigatoria. Usada por todos os agentes (orquestrador, fabrica de midia, etc).
GEMINI_API_KEY=

# Modelos Gemini
GEMINI_MODEL_TEXTO=gemini-3.6-flash
GEMINI_MODEL_IMAGEM=gemini-2.5-flash-image
GEMINI_MODEL_QA=gemini-3.6-flash

# --- Raciocínio e QA multimodal via OpenCode / DeepSeek ---
# O DeepSeek é o provedor primário; Gemini 3.6 é o fallback automático.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
OPENCODE_MODEL=deepseek-v4-flash-vision-exp
OPENCODE_TIMEOUT_SECONDS=60

# --- QA multimodal de imagem e vídeo ---
# A publicação é sempre bloqueada sem evidência QA aprovada.
GEMINI_QA_ENABLED=true
GEMINI_QA_REQUIRED=true
GEMINI_QA_MIN_SCORE=7.0

# --- Conversao (link no card visual / legenda — NAO e falado na narracao) ---
GUARDIAN_URL_CONVERSAO=https://guardian-ai.app

# --- Narracao hibrida: Google Chirp 3 HD + ElevenLabs ---
# auto: Chirp para Feed/Meta e ElevenLabs para TikTok/Shorts, com fallback.
# Valores aceitos: auto, chirp, elevenlabs
AUDIO_TTS_MODE=auto
AUDIO_TTS_FALLBACK=true
# Limite preventivo de custo por requisicao (maximo aceito: 5000).
AUDIO_TTS_MAX_CHARS=5000

# Google Cloud Text-to-Speech. Ative a API no projeto da chave.
# Opcional em modo auto, mas necessario para usar Chirp.
GOOGLE_CLOUD_TTS_API_KEY=
GOOGLE_CLOUD_TTS_VOICE=pt-BR-Chirp3-HD-Aoede

# ElevenLabs. Opcional em modo auto, mas necessario para usar ElevenLabs.
# O codigo aceita ELEVENLABS_API_KEY ou ELEVEN_LABS_API_KEY (nome legado).
ELEVENLABS_API_KEY=
# Modelo atual; use eleven_v3 somente apos validar a voz escolhida.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Opcional: id da voz (padrao Rachel multilingual).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Kling AI (geracao de video) ---
# Obrigatoria para o fluxo de video (Reels/Shorts).
# Kling 3.0 Turbo: use KLING_API_KEY (Bearer direto, gerada no Developer Console).
# Modelos legados: KLING_ACCESS_KEY + KLING_SECRET_KEY (JWT) — requer pip install PyJWT
KLING_API_KEY=
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# --- Meta / Facebook (gestor de trafego - opcional) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# App MKT_Guardian_Orchestrator — só para trocar token curto → long-lived (60 dias)
META_APP_ID=
META_APP_SECRET=

# --- Instagram (publicacao apos aprovacao Telegram) ---
# Conta @guardian_ai.app (NAO usar Instagram App ID 1048968290824377)
META_IG_USER_ID=
IMGBB_API_KEY=

# --- TikTok Content Posting (tokens obtidos no portal web OAuth) ---
# O arquivo oficial fica na raiz do clone (../.env) — use TIKTOK_REDIRECT_URI
# Redirect URI: https://guardian-ai.app/MKT-GUARDIAN-AUTO/tiktok/callback
# 2) No Railway (site): TIKTOK_CLIENT_KEY + TIKTOK_CLIENT_SECRET
# 3) Em https://guardian-ai.app/MKT-GUARDIAN-AUTO clique "Conectar TikTok"
# 4) Cole abaixo os tokens exibidos apos conectar (ou leia do Supabase mkt_integration_tokens)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://guardian-ai.app/MKT-GUARDIAN-AUTO/tiktok/callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
# TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# --- Ponte Linux ↔ Desktop via Supabase (backend somente) ---
# Ative apenas no Linux que executa a geração/publicação.
# Nunca use SUPABASE_SERVICE_ROLE_KEY no Desktop ou navegador.
SUPABASE_CAMPAIGN_SYNC=false
SUPABASE_URL=
# Chave publicável para o Desktop autenticado; nunca use service_role no cliente.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CAMPAIGN_BUCKET=mkt-campaign-assets
# Limite padrão: 1 GiB
SUPABASE_MAX_ASSET_BYTES=1073741824

# --- Telegram (aprovacao humana antes de publicar) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=3600
MAX_REVISOES=3
